.token-item
  .edit-token-icon
  .token-control
    display none
  &:hover
    .edit-token-icon
    .token-control
      display inline-block
.color-grey
  color #777
.token-str
  font-family monospace
.token-name-wrap
  display inline-block
  width 200px
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
.data-preview-wrap
  max-height 500px
  overflow auto
.font13
  font-size 13px
.font16
  font-size 16px
.danger-zone
  border 1px solid rgba(245, 34, 45, 0.35)
  border-radius 8px
  background #fff1f0
  padding 16px
  // keep the destructive action well clear of the main user functions above
  margin-top 100px
  .danger-zone-title
    font-size 16px
    color #f5222d
    margin-bottom 8px