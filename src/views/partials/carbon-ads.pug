// Carbon Ads — container only; footer JS injects the carbon.js script
//-  and toggles .carbon-ad-active. Same CN gating as EthicalAds.
//-  Layout mirrors ethical-ads: bottom bar (< 1420px) / corner card (>= 1420px).
#carbon-responsive.carbon-ad-wrapper

script.
  (function(){
    // === Carbon Ads — load for non-CN visitors ===
    fetch('/api/country')
      .then(function(r){ return r.json(); })
      .then(function(d){ return (d.country || '').toUpperCase(); })
      .catch(function(){ return null; })
      .then(function(cc){
        if (cc === 'CN') return;
        var wrapper = document.querySelector('.carbon-ad-wrapper');
        if (!wrapper) return;

        // === Carbon Ads — inject carbon.js into the container and reveal it ===
        wrapper.classList.add('carbon-ad-active');
        var cs = document.createElement('script');
        cs.async = true;
        cs.type = 'text/javascript';
        // serve/placement are Carbon Ads IDs; update for this domain as needed.
        cs.src = '//cdn.carbonads.com/carbon.js?serve=CWBDE2JL&placement=electermorg&format=responsive';
        cs.id = '_carbonads_js';
        wrapper.appendChild(cs);
      });

    // === Ad spacing: keep the fixed ad bar/card (Carbon Ads) from covering footer content ===
    var wrapper = document.querySelector('.carbon-ad-wrapper');
    var footer = document.querySelector('footer.site-footer');
    if (!wrapper) return;
    var BP = 1420;
    function apply() {
      var h = wrapper.offsetHeight || 0;
      var vw = window.innerWidth || document.documentElement.clientWidth;
      if (vw < BP) {
        document.body.style.paddingBottom = h + 'px';
        if (footer) {
          footer.style.paddingBottom = '';
          footer.style.setProperty('--watermark-height', '0px');
          footer.style.setProperty('--watermark-bottom', '0px');
          footer.style.setProperty('--watermark-bg-size', '0px');
        }
      } else {
        document.body.style.paddingBottom = '';
        if (footer) {
          if (h > 0) {
            var ph = (h + 32);
            var wh = Math.round(ph * 0.6);
            var wb = Math.round((ph - wh) / 2);
            var bg = Math.round(ph * 1.2);
            footer.style.paddingBottom = ph + 'px';
            footer.style.setProperty('--watermark-height', wh + 'px');
            footer.style.setProperty('--watermark-bottom', wb + 'px');
            footer.style.setProperty('--watermark-bg-size', bg + 'px');
          } else {
            footer.style.paddingBottom = '';
            footer.style.setProperty('--watermark-height', '0px');
            footer.style.setProperty('--watermark-bottom', '0px');
            footer.style.setProperty('--watermark-bg-size', '0px');
          }
        }
      }
    }
    if (window.ResizeObserver) {
      new ResizeObserver(function(){ apply(); }).observe(wrapper);
    }
    var rt = null;
    window.addEventListener('resize', function(){
      if (rt) clearTimeout(rt);
      rt = setTimeout(apply, 100);
    });
    apply();
    setTimeout(apply, 1500);
    setTimeout(apply, 3000);
  })();
