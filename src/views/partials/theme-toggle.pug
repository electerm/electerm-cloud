- var themeLabel = typeof lang !== 'undefined' && lang === 'cn' ? '深色主题' : 'Dark theme'
button.theme-toggle(type='button' aria-label=themeLabel title=themeLabel aria-pressed='true')
  svg.theme-icon.theme-icon-moon(viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.8', aria-hidden='true', focusable='false')
    path(d='M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1z')
  svg.theme-icon.theme-icon-sun(viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.8', aria-hidden='true', focusable='false')
    circle(cx='12', cy='12', r='4')
    line(x1='12', y1='2', x2='12', y2='4')
    line(x1='12', y1='20', x2='12', y2='22')
    line(x1='4.9', y1='4.9', x2='6.3', y2='6.3')
    line(x1='17.7', y1='17.7', x2='19.1', y2='19.1')
    line(x1='2', y1='12', x2='4', y2='12')
    line(x1='20', y1='12', x2='22', y2='12')
    line(x1='4.9', y1='19.1', x2='6.3', y2='17.7')
    line(x1='17.7', y1='6.3', x2='19.1', y2='4.9')
script.
  (function () {
    const button = document.currentScript.previousElementSibling
    const root = document.documentElement
    button.setAttribute('aria-pressed', String(root.dataset.theme !== 'light'))
    button.addEventListener('click', function () {
      const dark = root.dataset.theme === 'light'
      root.dataset.theme = dark ? 'dark' : 'light'
      button.setAttribute('aria-pressed', String(dark))
      document.querySelector('meta[name="theme-color"]').content = dark ? '#0f172a' : '#ffffff'
      try { localStorage.setItem('theme', root.dataset.theme) } catch {}
      document.dispatchEvent(new Event('themechange'))
    })
  })()
